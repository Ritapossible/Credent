{
  "name": "credent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "parity": "esbuild scripts/parity.ts --bundle --format=esm --platform=node --outfile=.tmp/parity.mjs && node .tmp/parity.mjs",
    "units": "esbuild scripts/units.ts --bundle --format=esm --platform=node --define:import.meta.env={} --outfile=.tmp/units.mjs && node .tmp/units.mjs",
    "livecheck": "esbuild scripts/livecheck.ts --bundle --format=esm --platform=node --packages=external --define:import.meta.env.VITE_CONTRACT_ADDRESS=process.env.VITE_CONTRACT_ADDRESS --define:import.meta.env.VITE_GENLAYER_NETWORK=process.env.VITE_GENLAYER_NETWORK --outfile=.tmp/livecheck.mjs && node .tmp/livecheck.mjs",
    "settlement": "esbuild scripts/settlement.ts --bundle --format=esm --platform=node --packages=external --define:import.meta.env.VITE_CONTRACT_ADDRESS=process.env.VITE_CONTRACT_ADDRESS --define:import.meta.env.VITE_GENLAYER_NETWORK=process.env.VITE_GENLAYER_NETWORK --outfile=.tmp/settlement.mjs && node .tmp/settlement.mjs",
    "payprobe": "esbuild scripts/payprobe.ts --bundle --format=esm --platform=node --packages=external --outfile=.tmp/payprobe.mjs && cp scripts/payprobe.py .tmp/payprobe.py && node .tmp/payprobe.mjs",
    "seed": "esbuild scripts/seed.ts --bundle --format=esm --platform=node --packages=external --define:import.meta.env.VITE_CONTRACT_ADDRESS=process.env.VITE_CONTRACT_ADDRESS --define:import.meta.env.VITE_GENLAYER_NETWORK=process.env.VITE_GENLAYER_NETWORK --outfile=.tmp/seed.mjs && node .tmp/seed.mjs",
    "verify-deployment": "esbuild scripts/verifyDeployment.ts --bundle --format=esm --platform=node --packages=external --outfile=.tmp/verifyDeployment.mjs && node .tmp/verifyDeployment.mjs",
    "uicheck": "esbuild scripts/uicheck.ts --bundle --format=esm --platform=node --outfile=.tmp/uicheck.mjs && node .tmp/uicheck.mjs",
    "agreement": "esbuild scripts/agreement.ts --bundle --format=esm --platform=node --packages=external --outfile=.tmp/agreement.mjs && node .tmp/agreement.mjs",
    "livedemo": "esbuild scripts/livedemo.ts --bundle --format=esm --platform=node --packages=external --define:import.meta.env.VITE_CONTRACT_ADDRESS=process.env.VITE_CONTRACT_ADDRESS --define:import.meta.env.VITE_GENLAYER_NETWORK=process.env.VITE_GENLAYER_NETWORK --outfile=.tmp/livedemo.mjs && cp scripts/claimant.py .tmp/claimant.py && node .tmp/livedemo.mjs",
    "recovery": "mkdir -p .tmp && cp scripts/recovery.mjs scripts/claimant.py .tmp/ && node .tmp/recovery.mjs"
  },
  "dependencies": {
    "genlayer-js": "^1.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.24.2",
    "typescript": "5.7.3",
    "vite": "6.0.11"
  }
}
