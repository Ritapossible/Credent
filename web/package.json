{
  "name": "credent-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "parity": "esbuild scripts/parity.ts --bundle --format=esm --platform=node --outfile=.tmp/parity.mjs && node .tmp/parity.mjs",
    "units": "esbuild scripts/units.ts --bundle --format=esm --platform=node --define:import.meta.env={} --outfile=.tmp/units.mjs && node .tmp/units.mjs"
  },
  "dependencies": {
    "genlayer-js": "^1.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router-dom": "7.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.24.2",
    "typescript": "5.7.3",
    "vite": "6.0.11"
  }
}
